# Template .env.prod. Berkas aslinya HANYA ada di VM (/home/vm-gpu/si-pd/.env.prod,
# chmod 600) — tidak pernah di-rsync, tidak pernah di-commit.
# Dipakai dua kali: `env_file:` service app (Laravel baca sebagai env var asli),
# dan `--env-file` compose untuk ${DB_*} di service db.
# JANGAN di-mount jadi /var/www/html/.env — php-fpm jalan sebagai www-data
# (uid 82) dan tidak bisa membaca berkas 600 milik uid 1000.

APP_NAME="SI PENDA"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://sipenda.blataktech.com

LOG_CHANNEL=stack
LOG_LEVEL=warning

# DB_HOST=db -> service `db` di compose.prod.yaml, bukan host luar.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=sipenda
DB_USERNAME=sipenda
DB_PASSWORD=
# Hanya untuk compose (MARIADB_ROOT_PASSWORD); Laravel tidak memakainya.
DB_ROOT_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# MinIO. Perhatikan endpoint-nya http:// — lihat catatan mixed content di
# dev-ops/home-server/sipenda.md.
AWS_ENDPOINT=http://157.245.61.121:9000
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=sipenda
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_URL=http://157.245.61.121:9000/sipenda/
